# Public URL used by the browser. Use the final HTTPS origin behind Nginx.
MOVIE_INBOX_PUBLIC_ORIGIN=http://localhost:8765
MOVIE_INBOX_BIND_ADDRESS=127.0.0.1
MOVIE_INBOX_PORT=8765

# Host paths. Windows paths can use forward slashes, for example D:/Peliculas.
MOVIE_INBOX_MEDIA_PATH=./media
MOVIE_INBOX_IMPORT_PATH=./imports
MOVIE_INBOX_OWNER_PASSWORD_FILE=./secrets/owner-password.txt
# Optional. Used only with compose.tmdb.example.yaml; the file contains the token.
# MOVIE_INBOX_TMDB_READ_ACCESS_TOKEN_FILE=./secrets/tmdb-read-access-token.txt
# Optional. Used only with compose.anime-offline.example.yaml; this directory
# contains the rebuildable anime-offline.db, never the application catalog.
# MOVIE_INBOX_ANIME_INDEX_DIR=./anime-index
MOVIE_INBOX_BACKUP_PATH=./backups
MOVIE_INBOX_BACKUP_RETENTION_DAYS=14

MOVIE_INBOX_OWNER_USERNAME=owner
MOVIE_INBOX_SESSION_DAYS=30
MOVIE_INBOX_IMAGE_CACHE_MB=512
MOVIE_INBOX_IMAGE_WARM_MODE=after-access
MOVIE_INBOX_IMAGE_WARM_INTERVAL_SECONDS=3
MOVIE_INBOX_FORWARDED_ALLOW_IPS=127.0.0.1

# Build settings normally do not need to change.
MOVIE_INBOX_IMAGE=movie-inbox:local
MOVIE_INBOX_PYTHON_VERSION=3.11
