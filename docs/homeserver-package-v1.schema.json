{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:movie-inbox:schema:homeserver-package:1",
  "title": "Movie Inbox homeserver package v1",
  "description": "Offline package manifest and curated collection payload. Product import remains intentionally unimplemented.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "payload"],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "schema_version", "package_id", "created_at", "source", "payload", "proof"],
      "properties": {
        "format": {"const": "movie-inbox-homeserver-package"},
        "schema_version": {"const": 1},
        "package_id": {"type": "string", "format": "uuid"},
        "created_at": {"type": "string", "format": "date-time"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instance_id"],
          "properties": {"instance_id": {"type": "string", "format": "uuid"}}
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"const": "payload.json"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
          }
        },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["manual", "ed25519"]},
            "key_id": {"type": "string", "minLength": 8, "maxLength": 200},
            "signature_path": {"const": "signature.ed25519"}
          },
          "allOf": [
            {
              "if": {"properties": {"mode": {"const": "ed25519"}}},
              "then": {"required": ["key_id", "signature_path"]},
              "else": {"not": {"anyOf": [{"required": ["key_id"]}, {"required": ["signature_path"]}]}}
            }
          ]
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "collection", "items"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "collection"},
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description"],
          "properties": {
            "title": {"type": "string", "minLength": 2, "maxLength": 120},
            "description": {"type": "string", "maxLength": 2000}
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "title", "kind", "identity"],
            "properties": {
              "position": {"type": "integer", "minimum": 1},
              "title": {"type": "string", "minLength": 1, "maxLength": 500},
              "original_title": {"type": "string", "minLength": 1, "maxLength": 500},
              "year": {"type": "integer", "minimum": 1800, "maximum": 3000},
              "kind": {"type": "string", "minLength": 1, "maxLength": 40},
              "directors": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
              "identity": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "imdb_id": {"type": "string", "pattern": "^tt[0-9]{5,12}$"},
                  "tmdb_id": {"type": "integer", "minimum": 1},
                  "wikidata_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
                  "mal_id": {"type": "integer", "minimum": 1}
                },
                "minProperties": 1
              }
            }
          }
        }
      }
    }
  }
}
